# Configuration for Astronaut Psychological Check-in Assistant
# NASA Space Apps Challenge 2026 - Health Monitoring Software

# =====================================================================
# LLM Provider Configuration (MOCK_LLM=true by default for zero-setup demo)
# =====================================================================
MOCK_LLM=true

# Provider: 'anthropic' or 'openai_compatible' (Gemini, Groq, OpenRouter, Ollama)
LLM_PROVIDER=anthropic

# Model Identifier (e.g. claude-sonnet-5-5, gemini-1.5-flash, llama-3.3-70b-versatile)
LLM_MODEL=claude-sonnet-5-5

# API Key (leave empty when MOCK_LLM=true)
LLM_API_KEY=

# Base URL for OpenAI-compatible providers (leave empty for Anthropic / official OpenAI)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Groq: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama local: http://localhost:11434/v1
LLM_BASE_URL=

# Legacy Anthropic configuration aliases
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# =====================================================================
# Database Configuration (SQLite default, PostgreSQL compatible)
# =====================================================================
DB_URL=sqlite:///./astronaut_checkin.db
# PostgreSQL example:
# DB_URL=postgresql://user:password@localhost:5432/astro_checkin

# =====================================================================
# Security, CORS & Authentication
# =====================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional API bearer token for endpoint protection (leave empty for open local dev)
API_TOKEN=
